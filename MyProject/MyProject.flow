        "systemPrompt": "Answer strictly from the supplied retrieved chunks. Do not use outside knowledge. If the answer is not supported by the chunks, say that the provided context does not contain the answer. Cite factual claims using exactly [document_name, Page/Row X], using the document_name and page_number from a chunk. Return a result conforming to the output schema. answer: the cited answer.",
        "userPrompt": "Retrieved chunks:\n{{ $vars.var_RetrievedChunks }}\n\nQuestion:\n{{ $vars.var_UserQuery }}",
        "model": "gpt-5.4",
        "mode": "standard",
        "temperature": 0,
        "maxTokenPerResponse": 16384,
        "maxIterations": 25,
        "isConversational": false,
        "guardrails": [],
        "name": "RAGAnswerAgent",
        "agentInputVariables": [
          {
            "id": "var_RetrievedChunks",
            "type": "string",
            "binding": "=js:$vars.var_RetrievedChunks"
          },
          {
            "id": "var_UserQuery",
            "type": "string",
            "binding": "=js:$vars.var_UserQuery"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "answer",
            "type": "string"
          }
        ],
        "source": "ea679537-0708-47ab-9eb9-beab0f743517",
        "modelMaxTokens": 128000
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "134715ca-9aee-4f1d-9fe8-f5ef9bc2d159"
    },
