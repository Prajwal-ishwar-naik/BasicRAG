    {
      "nodeType": "uipath.human-in-the-loop",
      "version": "1.7",
      "category": "human-task",
      "description": "Pause the process and wait for human task completion",
      "tags": [
        "human-task",
        "hitl",
        "human-in-the-loop",
        "approval"
      ],
      "sortOrder": 50,
      "display": {
        "label": "Human Task — Quick Form / App",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "outcome-completed",
              "label": "Completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:UserTask",
        "serviceType": "Actions.HITL"
      },
      "inputDefaults": {
        "type": "quick",
        "schema": {
          "fields": [],
          "outcomes": [
            {
              "id": "submit",
              "name": "Submit",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "user"
          }
        }
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output"
        },
        "status": {
          "type": "string",
          "description": "Task completion status (completed, cancelled, timeout)",
          "source": "=result.Action",
          "var": "status"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "hitl-properties",
        "title": "Human task configuration",
        "sections": [
          {
            "id": "task-type",
            "title": "Task Type",
            "collapsible": false,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.type",
                "type": "select",
                "label": "Type",
                "options": [
                  {
                    "label": "Quick Form",
                    "value": "quick"
                  },
                  {
                    "label": "Custom App",
                    "value": "custom"
                  }
                ]
              }
            ]
          },
          {
            "id": "assignment",
            "title": "Assignment criteria",
            "collapsible": false,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.recipient",
                "type": "custom",
                "component": "hitl-assignee-selector",
                "label": "",
                "description": ""
              }
            ]
          },
          {
            "id": "schema",
            "title": "Schema",
            "collapsible": true,
            "defaultExpanded": false,
            "fields": [
              {
                "name": "inputs.schema",
                "type": "custom",
                "component": "hitl-schema-editor",
                "label": "Task Schema",
                "description": "Define the input and output parameters for this task"
              }
            ]
          },
          {
            "id": "delivery",
            "title": "Delivery channels",
            "collapsible": false,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.recipient",
                "type": "custom",
                "component": "hitl-channel-selector",
                "label": "Delivery Channels",
                "description": "Select where the task should be sent"
              }
            ]
          },
          {
            "id": "additional-properties",
            "title": "Additional properties",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.title",
                "type": "text",
                "label": "Task title"
              },
              {
                "name": "inputs.priority",
                "type": "select",
                "label": "Priority",
                "options": [
                  {
                    "label": "Low",
                    "value": "Low"
                  },
                  {
                    "label": "Medium",
                    "value": "Medium"
                  },
                  {
                    "label": "High",
                    "value": "High"
                  }
                ]
              },
              {
                "name": "inputs.labels",
                "type": "text",
                "label": "Labels",
                "placeholder": "Comma-separated (e.g. finance,approval)"
              },
              {
                "name": "inputs.memorySpace",
                "type": "custom",
                "component": "hitl-memory-space-picker",
                "label": "Memory space",
                "description": "Attach a memory space so this task's inputs and outputs are written to it"
              }
            ]
          },
          {
            "id": "app",
            "title": "Custom Approval App",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.app",
                "type": "custom",
                "component": "hitl-app-picker",
                "label": "Action App",
                "description": "Select the coded action app for this task"
              },
              {
                "name": "inputs.appInputBindings",
                "type": "custom",
                "component": "hitl-app-inputs",
                "label": "Inputs",
                "description": "Map app inputs to expressions/variables"
              }
            ]
          }
        ]
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
