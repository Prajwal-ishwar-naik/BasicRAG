              "type": "string",
              "direction": "inOut",
              "binding": "=js:''",
              "required": true,
              "controlType": "textarea"
            }
          ],
          "outcomes": [
            {
              "id": "submit",
              "name": "Submit",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
          ]
        }
