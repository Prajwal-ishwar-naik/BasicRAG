              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Submit"
              ],
              "default": "Submit"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "descriptionKey": "hitlOutputBuilder_taskCompletionStatus_description",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Submit"
          ],
          "default": "Submit"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
